smartmonSataHealthGroup OBJECT-GROUP
    OBJECTS {
        smartmonSataHealthOverallStatus,
        smartmonSataOfflineCollectionStatusValue,
        smartmonSataSelfTestExecutionStatusValue,
        smartmonSataPowerCycles,
        smartmonSataPowerOnHours,
        smartmonSataErrorLogCount,
        smartmonSataPendingDefectsCount,
        smartmonSataSelfTestLogCount,
        smartmonSataSelfTestLogErrTotal,
        smartmonSataSelfTestLogErrOutdated,
        smartmonSataSctStatusFormatVersion,
        smartmonSataSctStatusSctVersion,
        smartmonSataSctStatusDeviceState,
        smartmonSataSctTempPowerCycleMin,
        smartmonSataSctTempPowerCycleMax,
        smartmonSataSctTempLifetimeMin,
        smartmonSataSctTempLifetimeMax,
        smartmonSataSctTempUnderLimitCount,
        smartmonSataSctTempOverLimitCount,
        smartmonSataSctSmartStatusPassed,
        smartmonSataSelfTestExecutionRemainingPct,
        smartmonSataSelfTestEstimatedCompletionTime,
        smartmonSataSelfTestEstimatedBytesSec
    }
    STATUS current
    DESCRIPTION "ATA/SATA SMART live-state objects (5-minute polling)."
    ::= { smartmonSataGroups 2 }

smartmonSataAttrGroup OBJECT-GROUP
    OBJECTS {
        smartmonSataAttrName,
        smartmonSataAttrFlags,
        smartmonSataAttrType,

smartmonSataPendingDefectsLbaGroup OBJECT-GROUP
    OBJECTS {
        smartmonSataPendingDefectsLba
    }
    STATUS current
    DESCRIPTION "ATA pending defects LBA entry objects."
    ::= { smartmonSataGroups 14 }

smartmonSataNotificationGroup NOTIFICATION-GROUP

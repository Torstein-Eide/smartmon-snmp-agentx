[Unit]
Description=SNMP AgentX subagent for smartmontools SMART data
Documentation=man:smartmon-snmp-agentx(8)
After=network.target snmpd.service smartmon-collect.timer
# snmpd must be running (AgentX master); the collect timer is optional
# (the agent can also poll smartctl itself with collect=true, or read
# smartd --jsonstate files)
Requires=snmpd.service
Wants=smartmon-collect.timer

[Service]
# Self-contained Python script (#!/usr/bin/env python3) using
# python3-netsnmpagent; runs directly via its shebang.  It does not implement
# sd_notify, so Type=simple (not notify) and no WatchdogSec.
Type=simple
ExecStart=@sbindir@/smartmon-snmp-agentx -f -c @sysconfdir@/smartmontools/snmp-agentx.yaml
Restart=on-failure
RestartSec=10

# ------------------------------------------------------------------ #
# Security hardening                                                 #
# The agent connects to the AgentX Unix socket and either reads JSON #
# state files (file mode) or polls smartctl (collect mode).  Collect #
# mode runs `sudo -n smartctl`, so a few directives below are relaxed #
# to permit that escalation and disk access.  File-mode-only          #
# deployments may re-tighten the four directives marked "collect".    #
# ------------------------------------------------------------------ #

# Run as a dedicated unprivileged system account created on install
User=smartmon
Group=smartmon

# collect: allow `sudo -n smartctl` to gain privilege.  NoNewPrivileges=yes
# would make sudo fail with "effective uid is not 0".  Grant the smartmon user
# passwordless smartctl in sudoers, e.g.:
#   smartmon ALL=(root) NOPASSWD: /usr/sbin/smartctl
NoNewPrivileges=no
# collect: do NOT empty CapabilityBoundingSet — the root smartctl spawned via
# sudo needs CAP_SYS_RAWIO / CAP_SYS_ADMIN / CAP_DAC_READ_SEARCH (and sudo
# itself needs CAP_SETUID/CAP_SETGID).  The default (full) bounding set is kept;
# the agent process itself runs unprivileged as smartmon.
AmbientCapabilities=

# Filesystem isolation
PrivateTmp=yes
# collect: real /dev must be visible so smartctl can open the drives.
PrivateDevices=no
ProtectHome=yes
# ProtectSystem=strict makes the entire filesystem read-only except for
# the paths listed in ReadWritePaths/ReadOnlyPaths below
ProtectSystem=strict
# Read JSON state files written by smartmon-collect or smartd (file mode)
ReadOnlyPaths=-/run/smartmontools/json
# AgentX socket directory plus SQLite state DB directory
ReadWritePaths=/var/agentx /run/agentx /var/lib/smartmontools/snmp-agent

# Network: AgentX uses Unix sockets by default; also allow TCP/UDP in
# case snmpd uses an agentxsocket tcp: address
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Kernel and process hardening
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

LockPersonality=yes
# NOTE: MemoryDenyWriteExecute is intentionally NOT enabled — the agent uses
# ctypes/libffi (python3-netsnmpagent and the trap callbacks), whose closure
# trampolines require writable+executable memory.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# System call filtering.  @system-service covers a standard daemon; collect
# mode additionally needs @raw-io (smartctl ATA/NVMe pass-through ioctls) and
# @privileged (sudo's setuid/setgid).  Anything else returns EPERM.
SystemCallArchitectures=native
SystemCallFilter=@system-service @raw-io @privileged
SystemCallErrorNumber=EPERM

# Resource limits
LimitNOFILE=256
LimitCORE=0

[Install]
WantedBy=multi-user.target

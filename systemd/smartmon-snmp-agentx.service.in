[Unit]
Description=SNMP AgentX subagent for smartmontools SMART data
Documentation=man:smartmon-snmp-agentx(8)
After=network.target snmpd.service smartmon-collect.timer
# snmpd must be running (AgentX master); the collect timer is optional
# (the agent can also poll smartctl itself with collect=true, or read
# smartd --jsonstate files)
Requires=snmpd.service
Wants=smartmon-collect.timer

[Service]
# Self-contained Python script (#!/usr/bin/env python3) using
# python3-netsnmpagent; runs directly via its shebang.  It does not implement
# sd_notify, so Type=simple (not notify) and no WatchdogSec.
Type=simple
ExecStart=@sbindir@/smartmon-snmp-agentx -f -c @sysconfdir@/smartmontools/snmp-agentx.conf
Restart=on-failure
RestartSec=10

# ------------------------------------------------------------------ #
# Security hardening                                                 #
# The agent only reads JSON state files and connects to the AgentX   #
# Unix socket.  No special privileges are needed at any point.       #
# ------------------------------------------------------------------ #

# Run as a dedicated unprivileged system account created on install
User=smartmon
Group=smartmon

# Prevent any privilege escalation via setuid/setgid
NoNewPrivileges=yes

# Drop all capabilities — the agent needs none
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem isolation
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
# ProtectSystem=strict makes the entire filesystem read-only except for
# the paths listed in ReadWritePaths/ReadOnlyPaths below
ProtectSystem=strict
# Read JSON state files written by smartmon-collect or smartd
ReadOnlyPaths=-/run/smartmontools/json
# AgentX socket directory plus SQLite state DB directory
ReadWritePaths=/var/agentx /run/agentx /var/lib/smartmontools/snmp-agent
# /dev/disk/by-id and /dev/disk/by-path are needed to populate
# smartmonDeviceUris.  PrivateDevices=yes hides the real /dev, so we
# bind-mount the by-* tree read-only into the private namespace.
# The symlink targets (/dev/sda, /dev/nvme0n1, …) need not exist
# inside the private /dev — we only read the symlinks, not the devices.
BindReadOnlyPaths=-/dev/disk

# Network: AgentX uses Unix sockets by default; also allow TCP/UDP in
# case snmpd uses an agentxsocket tcp: address
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Kernel and process hardening
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

LockPersonality=yes
# NOTE: MemoryDenyWriteExecute is intentionally NOT enabled — the agent uses
# ctypes/libffi (python3-netsnmpagent and the trap callbacks), whose closure
# trampolines require writable+executable memory.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# System call filtering — @system-service covers all calls a standard
# daemon legitimately makes; anything else returns EPERM
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
LimitNOFILE=256
LimitCORE=0

[Install]
WantedBy=multi-user.target

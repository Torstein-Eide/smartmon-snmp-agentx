# ci/Dockerfile.agentxd — build and integration-test smartmon-snmp-agentxd
#
# Base image: ghcr.io/smartmontools/docker-build:master
# Source:     https://github.com/smartmontools/docker-build
#
# Usage (from repo root):
#   ci/run_docker.sh
#   -- or manually:
#   docker build -f ci/Dockerfile.agentxd -t smartmon-agentxd-test .
#   docker run --rm \
#     -v "$PWD/.tmp/source:/fixtures:ro" \
#     -v "$PWD/.tmp/test:/output"       \
#     smartmon-agentxd-test
#
# The image:
#   1. Adds net-snmp build + runtime deps on top of the docker-build base
#   2. Copies MIB files into /usr/share/snmp/mibs/ for human-readable snmpwalk
#   3. Builds the standalone AgentX daemon sources
#   4. Runs the agentxd unit + integration tests against fixture JSON files
#   5. Verifies the binary responds to -h
#   6. On docker run: executes the live server+client integration test

FROM ghcr.io/smartmontools/docker-build:master

ARG DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Net-SNMP build + runtime dependencies
# (docker-build base already has g++, make, and common build tools)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsnmp-dev \
        snmpd \
        snmptrapd \
        snmp \
        python3-yaml \
        procps \
        rsync \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Copy source tree — use rsync with .gitignore rules so local build artifacts
# (*.o, .build/, .tmp/, ...) are excluded from /src.
# ---------------------------------------------------------------------------
COPY . /src-raw
RUN rsync -a --filter=':- .gitignore' --exclude='.git' /src-raw/ /src/ \
    && rm -rf /src-raw

# ---------------------------------------------------------------------------
# Install MIB files for human-readable snmpwalk output
# ---------------------------------------------------------------------------
RUN cp /src/doc/SMARTMON-*.mib /usr/share/snmp/mibs/

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
WORKDIR /src
RUN make BUILDDIR=/build SYSCONFDIR=/etc

# ---------------------------------------------------------------------------
# Unit + integration tests (no net-snmp runtime needed)
# Fixtures are committed at tests/fixtures/
# ---------------------------------------------------------------------------
RUN cd /src/tests && \
    make test FIXTURES=/src/tests/fixtures CXX=g++

# ---------------------------------------------------------------------------
# Smoke-test: binary must exist and respond to -h
# ---------------------------------------------------------------------------
RUN /build/smartmon-snmp-agentxd -h 2>&1 | grep -q "usage\|Usage\|Options\|-c\|config" \
    && echo "Binary smoke-test PASSED"

# ---------------------------------------------------------------------------
# Integration test defaults
# Default FIXTURES points to the committed test fixtures baked into the image.
# Override at runtime: docker run -v /your/data:/fixtures:ro ...
# ---------------------------------------------------------------------------
ENV AGENTXD_BIN=/build/smartmon-snmp-agentxd
ENV FIXTURES=/src/tests/fixtures
ENV OUTPUT=/output

RUN mkdir -p /output \
    && groupadd -r agentxd \
    && useradd -r -g agentxd -s /usr/sbin/nologin agentxd

# Run integration test as root so snmpd can create the AgentX socket and
# agentxd can connect to it.  The agentxd user above is provided for
# production deployments that want to run the binary as a non-root service.
CMD ["python3", "/src/ci/run_integration_test.py"]

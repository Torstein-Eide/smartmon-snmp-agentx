# ci/Dockerfile.debian11 - Debian 11 build environment for smartmon-snmp-agentxd.
#
# This image only installs the toolchain; it contains no source and runs no
# compilation.  Use build_debian11_export.sh to mount the repo and /out at
# runtime so artifacts land directly on the host without a docker cp step.
#
# Intentionally built against Debian 11 distro packages so exported binaries
# do not accidentally link against /usr/local libraries from a developer
# workstation.

FROM debian:11-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        file \
        g++ \
        libsnmp-dev \
        libsqlite3-dev \
        libsystemd-dev \
        make \
        snmp \
        snmpd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
